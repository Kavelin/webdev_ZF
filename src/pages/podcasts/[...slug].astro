---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PodcastPlayer from '../../components/PodcastPlayer';
import { ArrowLeft } from 'lucide-react';

export async function getStaticPaths() {
  const podcasts = await getCollection('podcasts');
  return podcasts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'podcasts'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={`${entry.data.title} — ZEALED FUJOSHI Podcast`}>
  <div class="min-h-screen bg-[#120A17] text-[#FDFFFC] pt-28 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back Link -->
      <a
        href="/podcasts"
        class="inline-flex items-center gap-2 text-xs font-mono text-[#FDFFFC]/60 hover:text-[#F61067] mb-8 transition-colors uppercase tracking-wider"
      >
        <ArrowLeft size={14} />
        <span>Back to Episodes</span>
      </a>

      <!-- Episode Header -->
      <div class="mb-10 space-y-4">
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono uppercase tracking-wider px-3 py-1 rounded-full bg-[#F61067]/10 text-[#F61067] border border-[#F61067]/30">
            S{entry.data.season} E{entry.data.episodeNumber}
          </span>
          <span class="text-xs font-mono uppercase tracking-wider px-3 py-1 rounded-full bg-[#6C3483]/30 text-[#FDFFFC]/80 border border-[#6C3483]/50">
            {entry.data.category.replace(/_/g, ' ')}
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl font-black text-[#FDFFFC] leading-tight">
          {entry.data.title}
        </h1>

        <p class="text-lg text-[#FDFFFC]/75 leading-relaxed">
          {entry.data.description}
        </p>
      </div>

      <!-- Guest Card -->
      {entry.data.guestName && (
        <div class="mb-10 p-6 rounded-2xl card-glass">
          <p class="text-xs font-mono text-[#F61067] uppercase tracking-widest mb-1">[ FEATURED GUEST ]</p>
          <h2 class="text-xl font-bold text-[#FDFFFC]">{entry.data.guestName}</h2>
          {entry.data.guestRole && (
            <p class="text-sm text-[#FDFFFC]/60 mt-0.5">{entry.data.guestRole}</p>
          )}
        </div>
      )}

      <!-- Audio Player Component -->
      <div class="mb-12">
        <PodcastPlayer
          client:load
          title={entry.data.title}
          description={entry.data.description}
          guestName={entry.data.guestName}
          audioUrl={entry.data.audioUrl}
          duration={entry.data.duration}
          spotifyUrl={entry.data.spotifyUrl}
          applePodcastsUrl={entry.data.applePodcastsUrl}
          youtubeUrl={entry.data.youtubeUrl}
          episodeNumber={entry.data.episodeNumber}
          season={entry.data.season}
        />
      </div>

      <!-- Episode Show Notes / Content -->
      <div class="prose prose-invert max-w-none p-8 rounded-3xl card-glass">
        <Content />
      </div>

      <!-- Bottom Navigation -->
      <div class="mt-16 pt-8 border-t border-white/10">
        <a
          href="/podcasts"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/[0.05] border border-white/15 text-[#FDFFFC] text-xs font-mono uppercase tracking-wider hover:bg-white/10 transition-colors"
        >
          <ArrowLeft size={14} />
          <span>All Episodes Archive</span>
        </a>
      </div>

    </div>
  </div>
</BaseLayout>