---
// src/components/PartnerMarquee.astro
// Animated scrolling ticker of partner logos
---

<section class="bg-zf-black border-y border-zf-gray py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-xs font-inter text-zf-light-gray uppercase tracking-widest mb-4">We've worked with leading industry partners</p>
    
    {/* Marquee Container */}
    <div class="relative w-full overflow-hidden">
      <div class="flex animate-marquee gap-12 whitespace-nowrap">
        {/* Original set */}
        <div class="flex gap-12 flex-shrink-0">
          {/* Bandai Logo */}
          <div class="flex items-center justify-center h-12 min-w-max opacity-80 hover:opacity-100 transition-opacity">
            <div class="text-center">
              <p class="text-sm font-jakarta font-bold text-zf-white">BANDAI</p>
              <p class="text-xs text-zf-cyan">Namco</p>
            </div>
          </div>

          {/* Good Smile Company */}
          <div class="flex items-center justify-center h-12 min-w-max opacity-80 hover:opacity-100 transition-opacity">
            <div class="text-center">
              <p class="text-sm font-jakarta font-bold text-zf-white">GOOD SMILE</p>
              <p class="text-xs text-zf-cyan">Company</p>
            </div>
          </div>

          {/* ABC7 Logo */}
          <div class="flex items-center justify-center h-12 min-w-max opacity-80 hover:opacity-100 transition-opacity">
            <div class="text-center">
              <p class="text-sm font-jakarta font-bold text-zf-white">ABC7</p>
              <p class="text-xs text-zf-cyan">Chicago</p>
            </div>
          </div>

          {/* Lezhin Comics */}
          <div class="flex items-center justify-center h-12 min-w-max opacity-80 hover:opacity-100 transition-opacity">
            <div class="text-center">
              <p class="text-sm font-jakarta font-bold text-zf-white">LEZHIN</p>
              <p class="text-xs text-zf-cyan">Comics</p>
            </div>
          </div>
        </div>

        {/* Duplicate for seamless loop */}
        <div class="flex gap-12 flex-shrink-0">
          <div class="flex items-center justify-center h-12 min-w-max opacity-80 hover:opacity-100 transition-opacity">
            <div class="text-center">
              <p class="text-sm font-jakarta font-bold text-zf-white">BANDAI</p>
              <p class="text-xs text-zf-cyan">Namco</p>
            </div>
          </div>

          <div class="flex items-center justify-center h-12 min-w-max opacity-80 hover:opacity-100 transition-opacity">
            <div class="text-center">
              <p class="text-sm font-jakarta font-bold text-zf-white">GOOD SMILE</p>
              <p class="text-xs text-zf-cyan">Company</p>
            </div>
          </div>

          <div class="flex items-center justify-center h-12 min-w-max opacity-80 hover:opacity-100 transition-opacity">
            <div class="text-center">
              <p class="text-sm font-jakarta font-bold text-zf-white">ABC7</p>
              <p class="text-xs text-zf-cyan">Chicago</p>
            </div>
          </div>

          <div class="flex items-center justify-center h-12 min-w-max opacity-80 hover:opacity-100 transition-opacity">
            <div class="text-center">
              <p class="text-sm font-jakarta font-bold text-zf-white">LEZHIN</p>
              <p class="text-xs text-zf-cyan">Comics</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee 30s linear infinite;
  }

  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>
