---
// src/components/PodcastGrid.astro
// Display podcast episodes in a grid with brief info

import { getCollection } from 'astro:content';

const podcasts = await getCollection('podcasts');

// Sort by newest first
podcasts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Format date
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: '2-digit' });
};

// Category colors
const categoryColors: Record<string, string> = {
  'VOICE_ACTOR': 'badge-press',
  'PUBLISHER': 'badge-category',
  'CONVENTION': 'badge-press',
  'GENERAL': 'badge-category',
};
---

<div class="grid-responsive">
  {podcasts.map((podcast) => (
    <div class="card p-6 group">
      {/* Episode Number Badge */}
      <div class="flex items-center justify-between mb-4">
        <span class="text-xs badge bg-zf-gray text-zf-white">
          S{podcast.data.season}E{podcast.data.episodeNumber}
        </span>
        <span class="text-xs text-zf-light-gray font-inter">
          {formatDate(podcast.data.pubDate)}
        </span>
      </div>

      {/* Title */}
      <h4 class="text-lg font-jakarta font-bold text-zf-white mb-3 group-hover:text-zf-crimson transition-colors line-clamp-2">
        {podcast.data.title}
      </h4>

      {/* Guest Info */}
      {podcast.data.guestName && (
        <p class="text-sm text-zf-cyan font-inter mb-2">
          🎙 {podcast.data.guestName}
          {podcast.data.guestRole && <span class="text-zf-light-gray"> • {podcast.data.guestRole}</span>}
        </p>
      )}

      {/* Description */}
      <p class="text-sm text-zf-light-gray font-inter mb-4 line-clamp-3">
        {podcast.data.description}
      </p>

      {/* Footer */}
      <div class="flex items-center justify-between pt-4 border-t border-zf-gray">
        <div class="flex gap-2">
          <span class={`text-xs badge ${categoryColors[podcast.data.category] || 'badge-category'}`}>
            {podcast.data.category.replace('_', ' ')}
          </span>
        </div>
        <div class="text-xs text-zf-light-gray font-inter">
          {Math.round(podcast.data.duration / 60)} min
        </div>
      </div>
    </div>
  ))}
</div>
