---
// src/components/StructuredData.astro
// Generate JSON-LD structured data for SEO

interface Props {
  type: 'NewsArticle' | 'PodcastEpisode' | 'Organization';
  data: Record<string, any>;
}

const { type, data } = Astro.props;

let schema: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': type,
};

if (type === 'NewsArticle') {
  schema = {
    ...schema,
    headline: data.title,
    description: data.summary,
    image: data.coverImage || '/images/zealed-fujoshi-og.png',
    datePublished: data.pubDate.toISOString(),
    author: {
      '@type': 'Person',
      name: data.author || 'Zealed Fujoshi Press',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Zealed Fujoshi Press',
      logo: {
        '@type': 'ImageObject',
        url: 'https://zealedfujoshi.xyz/images/logo.png',
      },
    },
    mainEntity: {
      '@type': 'NewsArticle',
      headline: data.title,
    },
  };
} else if (type === 'PodcastEpisode') {
  schema = {
    ...schema,
    name: data.title,
    description: data.description,
    episodeNumber: data.episodeNumber,
    seasonNumber: data.season,
    datePublished: data.pubDate.toISOString(),
    duration: `PT${Math.round(data.duration / 60)}M`,
    url: data.url || '#',
    audio: {
      '@type': 'AudioObject',
      url: data.audioUrl,
      contentUrl: data.audioUrl,
      duration: `PT${Math.round(data.duration / 60)}M`,
    },
    podcastSeries: {
      '@type': 'PodcastSeries',
      name: 'Zealed Fujoshi Podcast',
    },
  };

  if (data.guestName) {
    schema.guest = {
      '@type': 'Person',
      name: data.guestName,
    };
  }
} else if (type === 'Organization') {
  schema = {
    ...schema,
    name: 'Zealed Fujoshi Press',
    url: 'https://zealedfujoshi.xyz',
    logo: 'https://zealedfujoshi.xyz/images/logo.png',
    description: 'Official press outlet for anime, voice acting, and BL/manhwa culture.',
    sameAs: [
      'https://twitter.com/zealedfujoshi',
      'https://www.instagram.com/zealedfujoshi',
      'https://www.youtube.com/c/ZealedFujoshi',
      'https://discord.com/invite/UngnnVQrXH',
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'Press Relations',
      email: 'press@zealedfujoshi.xyz',
    },
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
