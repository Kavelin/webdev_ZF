---
// src/components/PressGrid.astro
// Display press articles and interviews in editorial grid

import { getCollection } from 'astro:content';

const pressArticles = await getCollection('press');

// Sort by newest first, featured articles first
pressArticles.sort((a, b) => {
  if (a.data.featured !== b.data.featured) {
    return (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0);
  }
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

// Format date
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: '2-digit' });
};

// Category colors
const categoryColors: Record<string, string> = {
  'VA_INTERVIEW': 'badge-press',
  'PRESS_RELEASE': 'badge-category',
  'CONVENTION_RECAP': 'badge-gold',
  'REVIEW': 'badge-category',
  'ANNOUNCEMENT': 'badge-category',
};
---

<div class="space-y-6">
  {pressArticles.map((article, index) => (
    <a href={`/press/${article.slug}`} class="card p-6 group hover:bg-zf-gray transition-colors">
      <div class="flex gap-6">
        {/* Cover Image (if available) */}
        {article.data.coverImage && (
          <div class="hidden md:block flex-shrink-0 w-48 h-40 rounded overflow-hidden bg-zf-gray">
            <img
              src={article.data.coverImage}
              alt={article.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform"
            />
          </div>
        )}

        {/* Content */}
        <div class="flex-1 min-w-0">
          {/* Header */}
          <div class="flex items-center justify-between mb-3 gap-4 flex-wrap">
            <div class="flex items-center gap-2">
              <span class={`text-xs badge ${categoryColors[article.data.category] || 'badge-category'}`}>
                {article.data.category.replace(/_/g, ' ')}
              </span>
              {article.data.featured && (
                <span class="text-xs badge bg-zf-gold/20 text-zf-gold border border-zf-gold/40">
                  ⭐ FEATURED
                </span>
              )}
            </div>
            <span class="text-xs text-zf-light-gray font-inter flex-shrink-0">
              {formatDate(article.data.pubDate)}
            </span>
          </div>

          {/* Title */}
          <h3 class="text-xl lg:text-2xl font-jakarta font-bold text-zf-white mb-3 group-hover:text-zf-crimson transition-colors line-clamp-2">
            {article.data.title}
          </h3>

          {/* Summary */}
          <p class="text-sm lg:text-base text-zf-light-gray font-inter mb-4 line-clamp-2">
            {article.data.summary}
          </p>

          {/* Footer */}
          <div class="flex items-center justify-between pt-4 border-t border-zf-gray">
            <div class="flex items-center gap-4 text-xs text-zf-light-gray font-inter">
              <span>By {article.data.author}</span>
              <span>•</span>
              <span>{article.data.readingTime} min read</span>
            </div>
            {article.data.tags && article.data.tags.length > 0 && (
              <div class="flex gap-2 flex-wrap justify-end">
                {article.data.tags.slice(0, 2).map((tag) => (
                  <span class="text-xs bg-zf-gray text-zf-cyan px-2 py-1 rounded">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </a>
  ))}
</div>
