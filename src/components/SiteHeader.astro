---
// Modern header with branding and social links
// Lives above the navigation bar

interface SocialLink {
  name: string;
  href: string;
  title: string;
  icon: string;
}

const socials: SocialLink[] = [
  { name: "twitter",   href: "https://twitter.com/zealedfujoshi",      title: "Twitter/X", icon: "𝕏" },
  { name: "instagram", href: "https://www.instagram.com/zealedfujoshi", title: "Instagram", icon: "📷" },
  { name: "youtube",   href: "https://www.youtube.com/c/ZealedFujoshi", title: "YouTube", icon: "▶" },
  { name: "discord",   href: "https://discord.com/invite/UngnnVQrXH",   title: "Discord", icon: "💬" },
  { name: "email",     href: "mailto:zealedfujoshi@gmail.com",         title: "Email", icon: "✉" },
];
---

<div class="bg-zf-charcoal border-b border-zf-gray">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-4">
      {/* Left: Branding & Tagline */}
      <div class="flex-1">
        <p class="text-xs font-inter text-zf-light-gray tracking-widest uppercase">
          Official Anime & BL Press Outlet
        </p>
      </div>

      {/* Center: Call-to-action */}
      <div class="hidden md:flex items-center gap-2 flex-1 justify-center">
        <span class="text-xs font-inter text-zf-cyan">🎙 LISTEN LIVE NOW</span>
      </div>

      {/* Right: Social Links */}
      <div class="flex items-center gap-4 flex-1 justify-end">
        {socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            title={social.title}
            class="text-zf-light-gray hover:text-zf-cyan transition-colors text-sm font-inter"
            aria-label={social.title}
          >
            {social.icon}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>
